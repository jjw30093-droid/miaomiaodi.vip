def parse_llm_output(raw_text: str) -> dict:
    """
    Parse the structured LLM output into clean markdown + 4 meta fields.

    Expected format (post 2026-04 prompt restructure):
      ## 战力演化分析
      ...
      ## 阵容影响分析
      ...
      ## 战术博弈分析
      ...
      ## 综合结论
      ...
      ```json_meta
      { "beginner_summary": ..., "chart_insights": {...},
        "key_variables": [...], "key_risk": ... }
      ```

    Returns:
        {
          "markdown_content": str   # Markdown body (json_meta block stripped)
          "beginner_summary": str | None,
          "chart_insights":   str | None,  # JSON-stringified dict
          "key_variables":    str | None,  # JSON-stringified list
          "key_risk":         str | None,
        }

    Fallback: if json_meta missing or invalid, all 4 meta fields = None and
    markdown_content is the full raw_text. This keeps old/降级 reports working.
    """
    if not raw_text:
        return {
            "markdown_content": raw_text or "",
            "beginner_summary": None,
            "chart_insights":   None,
            "key_variables":    None,
            "key_risk":         None,
        }

    # Match ```json_meta { ... } ```  (DOTALL for multi-line JSON)
    m = re.search(r"```json_meta\s*(\{.*?\})\s*```", raw_text, re.DOTALL)

    meta = {}
    markdown_text = raw_text
    if m:
        try:
            meta = json.loads(m.group(1))
        except json.JSONDecodeError as e:
            log.warning(f"[parse_llm_output] json_meta 解析失败: {e}")
            meta = {}
        # Strip json_meta block from markdown body regardless of parse result
        markdown_text = (raw_text[: m.start()] + raw_text[m.end():]).strip()

    chart_insights = meta.get("chart_insights")
    key_variables  = meta.get("key_variables")

    return {
        "markdown_content": markdown_text,
        "beginner_summary": (meta.get("beginner_summary") or None) if meta else None,
        "chart_insights":   json.dumps(chart_insights, ensure_ascii=False) if isinstance(chart_insights, dict) and chart_insights else None,
        "key_variables":    json.dumps(key_variables,  ensure_ascii=False) if isinstance(key_variables,  list) and key_variables  else None,
        "key_risk":         (meta.get("key_risk") or None) if meta else None,
    }


def _sync_report_store(match_id, m, home_team, away_team, content, ml_output=None, lineup_data=None, version: str = "v3", parsed_meta: dict | None = None):
    """写入本地 report_store 表（云端 UPSERT 由 sync_router 负责）"""
    conn = sqlite3.connect(DB_PATH)
    # 禁用 auto-checkpoint：多进程并发时 WAL checkpoint 竞争会导致 D-state 卡死
    # PASSIVE checkpoint 在 conn.close() 时非阻塞尝试，不等待所有读者释放
    conn.execute("PRAGMA wal_autocheckpoint=0")
    conn.execute("PRAGMA busy_timeout=10000")  # 10s lock timeout 替代默认无限等
    h_id = m.get("home_id", 0)
    a_id = m.get("away_id", 0)
    kickoff = m.get("kickoff_time", "")
    m_time = kickoff  # 保留完整 "YYYY-MM-DD HH:MM:SS"
    h_icon = f"https://images.fotmob.com/image_resources/logo/teamlogo/{h_id}.png"
    a_icon = f"https://images.fotmob.com/image_resources/logo/teamlogo/{a_id}.png"

    # 使用 single_pick 作为 inference 摘要（唯一推荐）
    sp = (ml_output or {}).get("single_pick", {})
    wdl = (ml_output or {}).get("wdl", {})
    home_prob = round(wdl.get("home", 0.5) * 100, 1)
    draw_prob = round(wdl.get("draw", 0.2) * 100, 1)
    away_prob = round(wdl.get("away", 0.3) * 100, 1)

    # B6：前端 inference 不再携带 【HIGH/MID/LOW/观望】 前缀
    if sp:
        odds_str = f" @{sp['odds']}" if sp.get("odds") else ""
        prob_str = f"{round(sp.get('ml_prob', 0) * 100, 1)}%"
        inference = f"{sp['label']}{odds_str} {prob_str}  ({home_prob}%/{draw_prob}%/{away_prob}%)"
        if sp.get("secondary"):
            s2 = sp["secondary"]
            o2 = f" @{s2['odds']}" if s2.get("odds") else ""
            p2 = f"{round(s2.get('ml_prob', 0) * 100, 1)}%"
            inference += f"  +  {s2['label']}{o2} {p2}"
    else:
        inference = f"({home_prob}%/{draw_prob}%/{away_prob}%)"

    # Parsed meta (post 2026-04 prompt restructure); falls back to None for legacy callers.
    pm = parsed_meta or {}
    _md_for_db        = pm.get("markdown_content") or content
    _beginner_summary = pm.get("beginner_summary")
    _chart_insights   = pm.get("chart_insights")
    _key_variables    = pm.get("key_variables")
    _key_risk         = pm.get("key_risk")

    conn.execute("""
        INSERT OR REPLACE INTO report_store
            (match_id, title, markdown_content, preview_content,
             home_team, away_team, home_icon, away_icon,
             home_prob, away_prob, draw_prob, league, match_time,
             status, inference, pipeline_status, is_archived, is_public,
             lineup_data, version,
             beginner_summary, chart_insights, key_variables, key_risk)
        VALUES (?,?,?,?, ?,?,?,?, ?,?,?,?,?, ?,?,?, 0, 0, ?, ?,  ?,?,?,?)
    """, [
        str(match_id),
        f"研报: {home_team} vs {away_team}",
        _md_for_db, _md_for_db[:800],
        home_team, away_team, h_icon, a_icon,
        home_prob, away_prob, draw_prob,
        m.get("league", ""), m_time,
        "FREE", inference,
        "PRE_MATCH_READY",
        json.dumps(lineup_data, ensure_ascii=False) if lineup_data else None,
        version,
        _beginner_summary, _chart_insights, _key_variables, _key_risk,
    ])
    conn.commit()
    # PASSIVE：尽力将 WAL 已提交帧写回主库，有读者时立即返回（不阻塞）
    conn.execute("PRAGMA wal_checkpoint(PASSIVE)")
    conn.close()


