        'is_cup': '杯赛标识',
    }
    # 只显示 single_pick 对应市场的 SHAP（OU推荐只看OU归因，AH推荐看WDL归因）
    _sp_market = (ml_output.get('single_pick') or {}).get('market', 'AH').upper()
    _shap_wdl_md = ""
    if _shap_wdl and _sp_market != 'OU':  # WDL 或 AH 推荐时显示 WDL 归因
        _dir = _shap_wdl[0].get('direction', _wdl_pick_cn)
        _shap_wdl_md = f"\n**WDL 市场 Top-3 驱动特征（最强方向：{_dir}）**\n| 排名 | 特征（中文） | 归因值 |\n|---|---|---|\n"
        for _i, _s in enumerate(_shap_wdl[:3]):
            _shap_wdl_md += f"| {_i+1} | {_feat_cn.get(_s.get('feature',''), _s.get('feature',''))} | {_s.get('shap_value',0)} |\n"
    _shap_ou_md = ""
    if _shap_ou and _sp_market == 'OU':  # 仅 OU 推荐时显示 OU 归因
        _dir = _shap_ou[0].get('direction', _ou_pick_cn)
        _shap_ou_md = f"\n**大小球市场 Top-3 驱动特征（最强方向：{_dir}）**\n| 排名 | 特征（中文） | 归因值 |\n|---|---|---|\n"
        for _i, _s in enumerate(_shap_ou[:3]):
            _shap_ou_md += f"| {_i+1} | {_feat_cn.get(_s.get('feature',''), _s.get('feature',''))} | {_s.get('shap_value',0)} |\n"

    # SHAP 归因提升为独立 ## 节（不放在 量化概率基准线 内部），
    # 否则 sync_router.strip_widget_sections() 会把整个 ## 量化概率基准线 段落剥离，
    # 导致前端 report_narrative 里看不到 SHAP 表格。
    _shap_section = ""
    if _shap_wdl_md or _shap_ou_md:
        _shap_section = f"\n\n## 🔍 核心特征归因（算法决策驱动因素）\n{_shap_wdl_md}{_shap_ou_md}"
    _full_quant = f"## 🔬 量化概率基准线\n\n{_quant_table}"

    _lines = final_report.split('\n')
    _start, _end = None, None
    for _idx, _line in enumerate(_lines):
        if '量化概率基准线' in _line and _line.strip().startswith('#'):
            _start = _idx
        elif _start is not None and _idx > _start and _line.strip().startswith('## ') and '量化概率基准线' not in _line:
            _end = _idx
            break
    if _start is not None:
        _end = _end or len(_lines)
        # _shap_section 插在 量化概率基准线 之后、下一个 ## 之前，独立成节
        final_report = '\n'.join(_lines[:_start]) + '\n' + _full_quant + _shap_section + '\n\n' + '\n'.join(_lines[_end:])
    final_report = _re.sub(r'\n{3,}', '\n\n', final_report)

    # ── Step 4: 保存研报 ──
    report_path = os.path.join(REPORTS_DIR, f"report_{report_date}_{mid}.md")
    with open(report_path, "w", encoding="utf-8") as f:
        f.write(final_report)
    log.info(f"  [T] ✅ 研报已保存: report_{report_date}_{mid}.md")

    # ── Step 5a: 写入 report_store（独立连接，线程安全）──
    # 解析结构化 LLM 输出（4 H2 + json_meta），失败时所有 meta 字段写 NULL，主流程不阻断
    try:
        parsed_meta = parse_llm_output(final_report)
    except Exception as e:
        log.warning(f"  [T] parse_llm_output 失败 mid={mid}: {e}")
        parsed_meta = None
    try:
        _sync_report_store(mid, m, home_team, away_team, final_report, ml_output,
                           lineup_data=lineup_data, version=REPORT_VERSION,
                           parsed_meta=parsed_meta)
    except Exception as e:
        log.error(f"  [T] ❌ report_store 同步失败 mid={mid}: {e}")

    # ── Step 5b: 写入 prediction_audit（独立 ReviewEngine）──
    # CLAUDE.md §16: 透传 picks，让 log_prediction 在同事务内一并写
    # picked_market/direction/odds/confidence，杜绝 Phase 1/2 间隙。
    try:
        _review = ReviewEngine(DB_PATH, model_dir=MODEL_DIR)
        _review.log_prediction(mid, adapt_for_review(ml_output),
                               match_date=report_date,
                               home_name=home_team,
                               away_name=away_team,
                               ou_line=_market_line,
                               ah_pick=_ah_pick_for_audit,
                               ah_line=_ah_line_for_audit,
                               picks=job.get('picks'))
    except Exception as e:
        # CLAUDE.md §17 防御要点 1：升级为 ERROR + record_failure
        log.error(f"  [T] ❌ prediction_audit 写入失败 mid={mid}: {e}", exc_info=True)
        record_failure("run_tonight_reports", match_id=mid, step="log_prediction", error_msg=str(e))

    # ── Step 6: 推送 AWS ──
    log.info(f"  [T] 📡 推送 AWS: {m['match_name']}...")
    push_match_payload(mid)

    return {"match": m["match_name"], "match_id": mid, "path": report_path, "ml": ml_output}


def _process_match_with_503_retry(job, max_retries=3, sleep_s=65):
    """--final 模式：遇 503/UNAVAILABLE 休息 65s 重试（最多 3 次）。"""
    for attempt in range(max_retries):
        try:
            return _process_match_llm_phase(job)
        except Exception as e:
            msg = str(e)
            if "503" in msg or "UNAVAILABLE" in msg.upper() or "overloaded" in msg.lower():
                if attempt < max_retries - 1:
                    log.warning(
                        f"  [T] ⚠️ 503/overload on {job.get('mid')} attempt {attempt+1}/{max_retries}, sleep {sleep_s}s"
                    )
                    time.sleep(sleep_s)
                    continue
            raise


def _reconcile_picks_for_today(match_ids: List[str] = None) -> int:
    """CLAUDE.md §16 兜底闸门：扫描 prediction_audit.picked_market IS NULL 但
    report_store.inference 已存在的行，用 pick_parser 反解后补写，并写
    ingest_failure_log。正常情况应一场都不补；一旦补了就触发告警。

    Args:
        match_ids: 可选，限定本批次的 match_ids；不传则扫描全表近 7 天。
    Returns:
        int: 实际补写的行数。
    """
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    try:
        # CLAUDE.md §18：补 picks 后立即回算 picked_correct（已完赛场次）
        from pick_parser import compute_picked_correct
        base_select = """
            SELECT pa.match_id, rs.inference, pa.pred_ah_line, pa.pred_ou_line,
                   d.status, d.home_score, d.away_score
            FROM prediction_audit pa
            JOIN report_store rs ON CAST(rs.match_id AS TEXT) = CAST(pa.match_id AS TEXT)
            LEFT JOIN dim_match d ON CAST(d.Match_ID AS TEXT) = CAST(pa.match_id AS TEXT)
        """
        if match_ids:
            placeholders = ",".join("?" * len(match_ids))
            rows = conn.execute(base_select + f"""
                WHERE pa.match_id IN ({placeholders})
                  AND pa.picked_market IS NULL
                  AND rs.inference IS NOT NULL
                  AND TRIM(rs.inference) != ''
            """, [str(m) for m in match_ids]).fetchall()
        else:
            rows = conn.execute(base_select + """
                WHERE pa.match_date >= date('now', '-7 days')
                  AND pa.picked_market IS NULL
                  AND rs.inference IS NOT NULL
                  AND TRIM(rs.inference) != ''
            """).fetchall()

        fixed = 0
        for r in rows:
            mid = r["match_id"]
            parsed = parse_inference(r["inference"])
            if not parsed:
                log.error(f"[reconcile] 无法解析 inference, mid={mid}: {r['inference'][:80]}")
                record_failure("run_tonight_reports", match_id=mid,
                               step="reconcile_parse_failed", error_msg=r["inference"][:500])
                continue
            picked_correct = None
            if r["status"] == "Finish" and r["home_score"] is not None:
                picked_correct = compute_picked_correct(
                    parsed["market"], parsed["direction"],
                    r["home_score"], r["away_score"],
                    r["pred_ah_line"], r["pred_ou_line"],
                )
            conn.execute("""
                UPDATE prediction_audit SET
                    picked_market    = ?,
                    picked_direction = ?,
                    picked_odds      = ?,
                    picked_confidence= ?,
                    picked_correct   = COALESCE(picked_correct, ?)
                WHERE match_id = ? AND picked_market IS NULL
            """, (parsed["market"], parsed["direction"], parsed.get("odds"),
                  parsed.get("confidence"), picked_correct, mid))
            fixed += 1
            log.error(f"[reconcile] 补写 picks mid={mid}: {parsed['market']}/{parsed['direction']} correct={picked_correct}")
            record_failure("run_tonight_reports", match_id=mid,
                           step="reconcile_backfilled",
                           error_msg=f"picked_market 缺失，从 inference 反解补写: {parsed['market']}/{parsed['direction']} correct={picked_correct}")
        conn.commit()
        return fixed
    finally:
        conn.close()


def _validate_and_repair_target_coverage(matches: list) -> list:
    """
    §19 不变量：白名单联赛当天有比赛日，target_matches.json 不可为 0 场。
    校验 + 就地补抓（fotmob_scheduler 抓 BIG_FIVE 缺口），结果写回 .json。

    返回（可能已扩充的）matches 列表。
    """
    from datetime import datetime, timezone
    BIG_FIVE = [47, 87, 54, 55, 53]

    # 当前抓取窗口的日期集合（今 + 未来 2 天）
    now_utc = datetime.now(timezone.utc)
    window_dates = [(now_utc + pd.Timedelta(days=i)).strftime("%Y-%m-%d") for i in range(3)]

    big_five_count = sum(1 for m in matches if m.get("league_id") in BIG_FIVE)
    log.info(f"📊 target_matches 覆盖：total={len(matches)}, big_five={big_five_count}")

    # 与历史基线对比：查近 4 周 BIG_FIVE 中位场次（同 weekday）
    try:
        conn = sqlite3.connect(DB_PATH, timeout=5)
        # 最近 28 天 BIG_FIVE 总场次（粗基线）
        row = conn.execute(
            f"""SELECT COUNT(*) FROM dim_match
                WHERE League_ID IN ({','.join('?' * len(BIG_FIVE))})
                  AND Date >= date(?, '-28 days') AND Date < ?""",
            (*BIG_FIVE, now_utc.strftime("%Y-%m-%d"), now_utc.strftime("%Y-%m-%d")),
        ).fetchone()
        conn.close()
        baseline_28d = row[0] if row else 0
    except Exception as e:
        log.warning(f"baseline 查询失败：{e}")
        baseline_28d = 0

    # 赛季中（28 天 ≥ 5 场）但本次 BIG_FIVE < 5 → 视为缺口
    if baseline_28d >= 5 and big_five_count < 5:
        log.error(f"🚨 target 覆盖缺口：BIG_FIVE 仅 {big_five_count} 场（基线 28 天 {baseline_28d}），尝试就地补抓")
        try:
            record_failure(
                script_name="run_tonight_reports",
                step="target_coverage_gap",
                error_msg=f"big_five={big_five_count}, baseline_28d={baseline_28d}, dates={window_dates}",
            )
        except Exception:
            pass

        # 就地补抓：直接 import fotmob_scheduler 的抓取函数
        repair_failed = False
        repair_err = None
        try:
            from fotmob_scheduler import fetch_fotmob_schedule
            log.info("▶ 重新调用 fetch_fotmob_schedule() 补抓...")
            new_matches = fetch_fotmob_schedule()
            if new_matches and len(new_matches) > len(matches):
                log.info(f"✅ 补抓后 {len(new_matches)} 场（增加 {len(new_matches) - len(matches)} 场）")
                return new_matches
            else:
                repair_failed = True
                log.error(f"❌ 补抓未带来更多比赛（{len(new_matches) if new_matches else 0} 场）")
        except Exception as e:
            repair_failed = True
            repair_err = str(e)
            log.error(f"❌ 补抓异常：{e}")

        # 二次闸门也失败 → Server 酱告警（CLAUDE.md §19 收尾）
        if repair_failed:
            try:
                from notify_utils import notify
                title = "🚨 BIG_FIVE 赛程缺口未恢复"
                body = (
                    f"日期窗口：{window_dates}\n"
                    f"BIG_FIVE 实抓：{big_five_count}（基线 28 天 {baseline_28d}）\n"
                    f"二次补抓："
                    + (f"异常 {repair_err}" if repair_err else "未带来更多比赛")
                    + "\n\n请人工检查 fotmob API 与 target_matches.json，"
                      "必要时手动跑 scripts/repair_weekend_2026_04_25.py 模式补抓。"
                )
                notify(body, title=title)
            except Exception as e:
                log.error(f"Server 酱推送失败: {e}")

    return matches


def main():
    import argparse
    parser = argparse.ArgumentParser(description="生成今晚研报")
    parser.add_argument("--match_ids", nargs="+", metavar="MATCH_ID",
                        help="只处理指定 match_id（覆盖 schedule 文件）")
    parser.add_argument("--force", action="store_true",
                        help="强制重新生成，不跳过已过时的场次")
    parser.add_argument("--single-match", metavar="MATCH_ID",
                        help="便捷单场模式：等价于 --match_ids <MATCH_ID>")
    parser.add_argument("--version", choices=["v1", "v2", "v3"], default="v3",
                        help="研报版本标签：v1=赛程抓到立即 / v2=T-12h / v3=定稿")
    parser.add_argument("--final", action="store_true",
                        help="定稿模式：并发限制 2，遇 503 休息 65s 重试 3 次")
    args = parser.parse_args()

    # 把 CLI --version 同步到模块级常量，供线程函数读取（args 在线程内不在作用域）
    global REPORT_VERSION
    REPORT_VERSION = args.version

    # --single-match 是 --match_ids 单值别名
    if args.single_match and not args.match_ids:
        args.match_ids = [args.single_match]

    # 加载赛程 + 赔率
    with open(os.path.join(PROJECT_ROOT, "schedule/target_matches.json"), encoding="utf-8") as f:
        matches = json.load(f)

    # ── §19 target_matches 覆盖不变量校验（仅全量模式，--match_ids 跳过）──
    if not args.match_ids:
        try:
            matches = _validate_and_repair_target_coverage(matches)
        except Exception as e:
            log.error(f"target_coverage 校验异常（不阻断主流程）: {e}")

    # --match_ids 过滤：从 schedule 中只保留指定场次；若不在 schedule 则构造最小 stub
    if args.match_ids:
        id_set = set(str(x) for x in args.match_ids)
        matches = [m for m in matches if str(m.get("match_id", "")) in id_set]
        if not matches:
            # schedule 里没有，从 report_store 重建 stub
            import sqlite3 as _sq
            _conn = _sq.connect(DB_PATH)
            _conn.row_factory = _sq.Row
            for mid in id_set:
                row = _conn.execute(
                    "SELECT match_id, home_team, away_team, league, match_time FROM report_store WHERE match_id=?",
                    (mid,)
                ).fetchone()
                if row:
                    # 解析 home_id / away_id: 优先 dim_match，兜底用队名反查历史记录
                    dm = _conn.execute(
                        "SELECT Home_Team_ID, Away_Team_ID FROM dim_match WHERE Match_ID=?",
                        (int(mid),)
                    ).fetchone()
                    h_id = dm["Home_Team_ID"] if dm else 0
                    a_id = dm["Away_Team_ID"] if dm else 0

                    # 兜底：队名反查（未来比赛不在dim_match时）
                    if not h_id:
                        r = _conn.execute(
                            "SELECT Home_Team_ID FROM dim_match WHERE Home_Team_Name=? AND Home_Team_ID IS NOT NULL ORDER BY Date DESC LIMIT 1",
                            (row['home_team'],)
                        ).fetchone()
                        h_id = r[0] if r else 0
                    if not a_id:
                        r = _conn.execute(
                            "SELECT Away_Team_ID FROM dim_match WHERE Away_Team_Name=? AND Away_Team_ID IS NOT NULL ORDER BY Date DESC LIMIT 1",
                            (row['away_team'],)
                        ).fetchone()
                        a_id = r[0] if r else 0

                    # 获取 league_id（用于 is_cup 特征）
                    league_str = row["league"] or ""
                    league_id = 0
                    if 'Champions' in league_str or 'UCL' in league_str:
                        league_id = 42
                    elif 'Europa' in league_str or 'UEL' in league_str:
                        league_id = 73

                    matches.append({
                        "match_id":     int(mid),
                        "match_name":   f"{row['home_team']} vs {row['away_team']}",
                        "kickoff_time": row["match_time"],
                        "league":       league_str,
                        "league_id":    league_id,
                        "home_id":      h_id,
                        "away_id":      a_id,
                    })
            _conn.close()
        log.info(f"[--match_ids] 仅处理: {[str(m['match_id']) for m in matches]}")

    try:
        with open(os.path.join(PROJECT_ROOT, "odds/match_odds_data.json"), encoding="utf-8") as f:
            odds_raw = json.load(f)
    except FileNotFoundError:
        odds_raw = []
    odds_index = {str(o["fotmob_id"]): o.get("odds", {}) for o in odds_raw}

    model_wdl, model_ou, FEATURES = load_models()
    calibrators  = load_calibrators()
    ah_predictor = load_ah_predictor()   # AH 独立预测器（Dixon-Coles + xG）
    # 初始化 SHAP Explainer（仅加载一次，复用）
    explainer_wdl = shap.TreeExplainer(model_wdl)
    explainer_ou  = shap.TreeExplainer(model_ou)
    review = ReviewEngine(DB_PATH, model_dir=MODEL_DIR)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    today = date.today()

    report_date = today.strftime("%Y-%m-%d")
    all_summaries = []

    # ── 联赛优先排序（欧洲 > 亚洲）──────────────────────────────────────────
    matches.sort(key=lambda x: _league_priority_key(x.get('league', '')))
    log.info(f"📊 联赛优先排序完成。前5场: {[m.get('league','?') for m in matches[:5]]}")

    # ── 批量预抓取所有场次阵容（仅限未来场次，Chrome 只开关一次）──
    now_dt = datetime.now()
    future_matches = []
    for m in matches:
        kickoff_str = m.get("kickoff_time", "")
        if kickoff_str:
            try:
                if datetime.strptime(kickoff_str, "%Y-%m-%d %H:%M:%S") > now_dt:
                    future_matches.append(m)
            except:
                pass
    
    # --match_ids 模式：直接抓取指定场次的阵容（不需要批量Chrome）
    if args.match_ids:
        lineup_cache = {}
        for m in matches:
            mid_str = str(m["match_id"])
            try:
                from lineup_fetcher import fetch_lineup as _fetch_lineup
                ld = _fetch_lineup(mid_str)
                if ld:
                    lineup_cache[mid_str] = ld
                    log.info(f"  ✅ 阵容已抓取: {m['match_name']} [{ld.get('status')}]")
            except Exception as e:
                log.warning(f"  ⚠️ 阵容抓取失败 {mid_str}: {e}")
    else:
        match_ids_for_lineup = [str(m["match_id"]) for m in future_matches]
        log.info(f"📋 批量抓取 {len(match_ids_for_lineup)} 场未来比赛阵容（Chrome 单次启动）...")
        try:
            lineup_cache = fetch_lineups_batch(match_ids_for_lineup)
            ok_count = sum(1 for v in lineup_cache.values() if v)
            log.info(f"  阵容缓存完成: {ok_count}/{len(match_ids_for_lineup)} 场有数据")
        except Exception as e:
            log.error(f"  ❌ 批量阵容抓取失败: {e}，各场将使用空阵容继续")
            lineup_cache = {}

    # ── Phase 1: 顺序计算 ML + SHAP + 构建状态，生成 job 列表 ──────────────
    prepared_jobs = []
    for m in matches:
        mid = str(m["match_id"])
        name_parts = m["match_name"].split(" vs ")
        home_team = name_parts[0].strip()
        away_team = name_parts[1].strip() if len(name_parts) > 1 else ""
        log.info(f"\n{'='*55}")
        log.info(f"🔢 [Phase-1] ML预测: {m['match_name']}  [{mid}]")

        # ── Step 0: 时间过滤器（仅处理未来场次；--force 跳过此检查） ──
        kickoff_str = m.get("kickoff_time", "")
        if kickoff_str and not args.force:
            try:
                kickoff_dt = datetime.strptime(kickoff_str, "%Y-%m-%d %H:%M:%S")
                if kickoff_dt <= datetime.now():
                    log.info(f"⏭️  跳过已开球或已结束赛事: {m['match_name']} ({kickoff_str})")
                    continue
            except Exception as e:
                log.warning(f"  ⚠️ 时间解析失败: {e}")

        # ── Step 1: ML 预测 ──
        odds_data = odds_index.get(mid, {})
        eu = odds_data.get("european_1x2", {}).get("latest", {})
        eu_h = float(eu.get("home", 0) or 0)
        eu_d = float(eu.get("draw", 0) or 0)
        eu_a = float(eu.get("away", 0) or 0)

        h_feat = get_team_features(conn, m["home_id"], today)
        a_feat = get_team_features(conn, m["away_id"], today)

        CUP_LIDS = {42, 73, 10216, 132, 133, 134, 138, 141, 209}
        league_id = m.get("league_id", 0)
        is_cup = 1 if league_id in CUP_LIDS else 0
        ah     = odds_data.get("asian_handicap", {}).get("latest", {})
        ah_line = float(ah.get("line", 0) or 0)
        ah_home = float(ah.get("over_or_home", 0) or 0)
        ah_away = float(ah.get("under_or_away", 0) or 0)
        row    = build_feature_row(h_feat, a_feat, eu_h, eu_d, eu_a, is_cup=is_cup,
                                   ah_line=ah_line, ah_home=ah_home, ah_away=ah_away)
        X      = pd.DataFrame([row])[FEATURES].fillna(0)

        wdl_arr = model_wdl.predict(X)[0]
        ou_val  = float(model_ou.predict(X)[0])

        # ── 校准（Isotonic Regression）──────────────────────────────
        wdl_dict, ou_dict, is_calibrated = apply_calibration(wdl_arr, ou_val, calibrators)
        if is_calibrated:
            log.info(f"  ✅ 概率已校准 (Isotonic Regression)")
        else:
            log.warning(f"  ⚠️ 使用原始概率（未校准）")

        # ── SHAP 归因（用原始 wdl_arr，SHAP 需要原始预测值）──
        shap_wdl_top3 = _calc_shap_top3_wdl(explainer_wdl, X, wdl_arr, FEATURES)
        shap_ou_top3  = _calc_shap_top3_ou(explainer_ou,   X, ou_val,  FEATURES)

        # ── Step 1b: AH 独立预测（Dixon-Coles + xG 混合模型）──────────────
        ah_pred = None
        if ah_predictor and ah_line is not None:
            try:
                feat_row_ah = {c: (row.get(c, 0) if row.get(c) is not None else 0)
                               for c in LAMBDA_FEATURES}
                ah_features = pd.DataFrame([feat_row_ah])
                # 优先使用 dim_match 的完整队名（与 DC 训练集一致），回退到 match_name 分割
                _dm_row = conn.execute(
                    "SELECT Home_Team_Name, Away_Team_Name FROM dim_match WHERE Match_ID=?", (mid,)
                ).fetchone()
                if _dm_row:
                    home_name = _dm_row["Home_Team_Name"]
                    away_name = _dm_row["Away_Team_Name"]
                else:
                    match_parts = m.get("match_name", "").split(" vs ", 1)
                    home_name = match_parts[0].strip() if len(match_parts) == 2 else ""
                    away_name = match_parts[1].strip() if len(match_parts) == 2 else ""
                _h_in_dc = home_name in (getattr(ah_predictor.dc_model, 'attack_params', None) or {})
                _a_in_dc = away_name in (getattr(ah_predictor.dc_model, 'attack_params', None) or {})
                if not _h_in_dc or not _a_in_dc:
                    log.warning(f"  AH DC 球队未知: {home_name}={_h_in_dc}, {away_name}={_a_in_dc} → xG-only 回退")
                ah_pred = ah_predictor.predict_match(
                    home_name, away_name, ah_features, ah_line
                )
                log.info(
                    f"  AH({ah_line:+.2f}): cover={ah_pred['ah_cover']:.1%} "
                    f"push={ah_pred['ah_push']:.1%} away={ah_pred['ah_away_cover']:.1%} "
                    f"λ=({ah_pred['lambda_home']:.2f},{ah_pred['lambda_away']:.2f})"
                )
            except Exception as _e:
                log.warning(f"  AH 预测失败 ({home_team} vs {away_team}): {type(_e).__name__}: {_e}")

        # ── C3: Bivariate Poisson 联合预测（WDL + OU + AH 同源）──
        bp_pred = None
        try:
            match_parts = m.get("match_name", "").split(" vs ", 1)
            _hn = match_parts[0].strip() if len(match_parts) == 2 else ""
            _an = match_parts[1].strip() if len(match_parts) == 2 else ""
            ou_line_for_bp = float(odds_data.get("over_under", {}).get("latest", {}).get("line", 2.5) or 2.5)
            ah_line_for_bp = ah_line if ah_line is not None else 0.0
            bp_pred = _predict_bp(_hn, _an, ou_line=ou_line_for_bp, ah_line=ah_line_for_bp)
            if bp_pred:
                log.info(
                    f"  BP: WDL H={bp_pred['wdl']['home']:.1%}/D={bp_pred['wdl']['draw']:.1%}/"
                    f"A={bp_pred['wdl']['away']:.1%}  OU>{ou_line_for_bp}={bp_pred['ou']['over']:.1%}  "
                    f"AH {ah_line_for_bp:+.2f} cover={bp_pred['ah']['cover']:.1%}"
                )
        except Exception as _e:
            log.debug(f"  BP 预测跳过: {_e}")

        single_pick = _select_single_pick(wdl_dict, ou_dict, odds_data, ah_pred=ah_pred,
                                          league_id=league_id, bp_pred=bp_pred)
        # 以 single_pick 的置信等级为准（已含 A3 温度校准；仅后端可见）
        conf = single_pick["confidence"]

        # ── B2: 写入 prediction_audit.picked_* 供复盘分层 ──
        # _picks 必须在 try 之前构建：若 try 内 ReviewEngine 初始化失败，
        # 后面 prepared_jobs.append({'picks': _picks, ...}) 仍能透传到 Phase 2，
        # 由 log_prediction(picks=...) 在同事务内补救（CLAUDE.md §16 双写不变量）。
        _picks = [{
            "market":     (single_pick.get("market") or "").lower(),
            "direction":  single_pick.get("direction"),
            "odds":       single_pick.get("odds"),
            "confidence": single_pick.get("confidence"),
        }]
        if single_pick.get("secondary"):
            s = single_pick["secondary"]
            _picks.append({
                "market":     (s.get("market") or "").lower(),
                "direction":  s.get("direction"),
                "odds":       s.get("odds"),
                "confidence": s.get("confidence"),
            })
        try:
            _rev = ReviewEngine(DB_PATH)
            _rev.record_picked(mid, _picks)
            _rev.close()
        except Exception as _e:
            # CLAUDE.md §17 防御要点 1：不再 silent warning，写 ingest_failure_log
            log.error(f"  ❌ record_picked 失败 mid={mid}: {_e}", exc_info=True)
            record_failure("run_tonight_reports", match_id=mid, step="record_picked", error_msg=str(_e))

        ml_output = {
            "match_id":      mid,
            "wdl":           wdl_dict,
            "ou":            ou_dict,
            "ah":            ah_pred,          # AH 独立预测（可能为 None）
            "bp":            bp_pred,          # Bivariate Poisson 联合预测（可能为 None）
            "single_pick":   single_pick,
            "shap_wdl_top3": shap_wdl_top3,
            "shap_ou_top3":  shap_ou_top3,
            "attribution":   shap_wdl_top3,   # 向后兼容
            "confidence":    conf,
            "is_calibrated": is_calibrated,
        }
        cal_tag = "校准✅" if is_calibrated else "原始⚠️"
        log.info(
            f"  ML({cal_tag}): H={wdl_dict['home']:.1%} D={wdl_dict['draw']:.1%} A={wdl_dict['away']:.1%}"
            f"  O2.5={ou_dict['over_25']:.1%}  [{conf}]"
            f"  → 推荐: [{single_pick['market']}] {single_pick['label']}"
            f"  p={single_pick['ml_prob']:.1%}  score={single_pick.get('conf_score',0):.2f}  {single_pick['confidence']}"
        )

        # ── Step 2a: 从缓存读取阵容（已在循环前批量抓取）──
        lineup_data = lineup_cache.get(mid) or {}
        if lineup_data:
            h_status = lineup_data.get("status", "")
            h_info   = lineup_data.get("home", {})
            a_info   = lineup_data.get("away", {})
            log.info(
                f"  阵容[{h_status}]: 主({h_info.get('formation')} "
                f"首发{len(h_info.get('starters', []))} 替补{len(h_info.get('bench', []))} 缺{len(h_info.get('missing', []))}) "
                f"客({a_info.get('formation')} "
                f"首发{len(a_info.get('starters', []))} 替补{len(a_info.get('bench', []))} 缺{len(a_info.get('missing', []))})"
            )
        else:
            log.warning("  ⚠️ 阵容暂不可用，Agent 3 将以伤停数据缺失模式运行")

        # ── Step 2b: 构建 workflow 状态 ──
        state = {
            "match_id":   mid,
            "match_info": {
                "home_name": home_team,
                "away_name": away_team,
                "league":    m.get("league", ""),
                "date":      m.get("kickoff_time", "")[:10],
                "kickoff":   m.get("kickoff_time", ""),
            },
            "ml_output":          ml_output,
            "odds_data":          odds_data,
            "lineup_data":        lineup_data,
            "team_stats_summary": {
                "home_elo":            round(h_feat["elo"], 1),
                "away_elo":            round(a_feat["elo"], 1),
                "elo_diff":            round(h_feat["elo"] - a_feat["elo"], 1),
                "home_rest_days":      h_feat["rest"],
                "away_rest_days":      a_feat["rest"],
                "home_npxGD":          round(h_feat["rf"].get("roll_5_npxGD", 0) or 0, 3),
                "away_npxGD":          round(a_feat["rf"].get("roll_5_npxGD", 0) or 0, 3),
                "home_ppda":           round(h_feat["rf"].get("roll_5_ppda", 0) or 0, 3),
                "away_ppda":           round(a_feat["rf"].get("roll_5_ppda", 0) or 0, 3),
                "home_field_tilt":     round(h_feat["rf"].get("roll_5_field_tilt", 0) or 0, 3),
                "away_field_tilt":     round(a_feat["rf"].get("roll_5_field_tilt", 0) or 0, 3),
                "home_xGA_impact_score": 0,
                "away_xGA_impact_score": 0,
            },
            "agent1_output": "",
            "agent2_output": "",
            "agent3_output": "",
            "prebuilt_quant_section": "",
            "final_report":  "",
        }

        # ── Step 2c: 生成量化概率基准线（Python精确生成，不依赖LLM）──
        _wdl = wdl_dict
        _ou  = ou_dict

        # 取实际市场 OU 线，将 P(>2.5) 转换为 P(>market_line)
        _ou_raw      = odds_data.get("over_under", {}).get("latest", {})
        _market_line = float(_ou_raw.get("line", 2.5) or 2.5)
        _ou_over_raw = _poisson_convert_ou(_ou.get("over_25", 0), _market_line)

        # 联赛 OU 偏置（与 _select_single_pick 保持一致）
        _ou_calib    = _get_ou_calibration()
        _lid_info    = _ou_calib.get(league_id, {}) if league_id else {}
        _ou_bias     = _lid_info.get("bias", _GLOBAL_OU_BIAS)
        _ou_over_mkt = round(min(0.97, max(0.03, _ou_over_raw + _ou_bias)), 4)
        _ou_undr_mkt = round(1.0 - _ou_over_mkt, 4)

        # 将市场调整后的概率写回 ou_dict，供 Agent 和 value_edge 使用
        ou_dict["market_line"]   = _market_line
        ou_dict["over_market"]   = round(_ou_over_mkt, 4)
        ou_dict["under_market"]  = round(_ou_undr_mkt, 4)

        # (A) Post-hoc OU bias shift：仅用于 UI/研报展示的“推荐方向”，不覆盖 ou_dict 原始值
        _p_ou_over_adj = max(0.01, min(0.99, float(_ou_over_mkt) + OU_BIAS_SHIFT))
        _p_ou_under_adj = round(1.0 - _p_ou_over_adj, 4)

        _h_pct = round(_wdl.get('home', 0) * 100, 1)
        _d_pct = round(_wdl.get('draw', 0) * 100, 1)
        _a_pct = round(_wdl.get('away', 0) * 100, 1)
        _o_pct = round(_p_ou_over_adj * 100, 1)
        _u_pct = round(_p_ou_under_adj * 100, 1)
        _wdl_pick_cn = {'home': '主胜', 'draw': '平局', 'away': '客胜'}.get(
            max(_wdl, key=_wdl.get) if _wdl else '', '—')
        _ou_pick_cn = f'大球(>{_market_line})' if _p_ou_over_adj > 0.5 else f'小球(≤{_market_line})'

        _quant_table = (
            f"| 市场 | 主胜 | 平局 | 客胜 | 推荐方向 | 置信度 |\n"
            f"|------|------|------|------|----------|--------|\n"
            f"| **胜平负** | {_h_pct}% | {_d_pct}% | {_a_pct}% | {_wdl_pick_cn} | {conf} |\n\n"
            f"| 市场 | 大球(>{_market_line}) | 小球(≤{_market_line}) | 推荐方向 |\n"
            f"|------|-----------|-----------|----------|\n"
            f"| **大小球** | {_o_pct}% | {_u_pct}% | {_ou_pick_cn} |"
        )

        # ── 亚盘维度（Dixon-Coles + xG AH 模型）──
        if ah_pred and ah_line is not None:
            _ah_cover_pct = round(ah_pred['ah_cover'] * 100, 1)
            _ah_away_pct  = round(ah_pred['ah_away_cover'] * 100, 1)
            _ah_push_pct  = round(ah_pred['ah_push'] * 100, 1)
            _ah_lam_h     = round(ah_pred.get('lambda_home', 0), 2)
            _ah_lam_a     = round(ah_pred.get('lambda_away', 0), 2)
            # NowGoal 约定：正值 = 主队让分（主让），负值 = 主队受让（主受）
            if ah_line > 0:
                _ah_h_label = f"主让{abs(ah_line):.2g}"
                _ah_a_label = f"客受{abs(ah_line):.2g}"
            else:
                _ah_h_label = f"主受{abs(ah_line):.2g}"
                _ah_a_label = f"客让{abs(ah_line):.2g}"
            _quant_table += (
                f"\n\n| 市场 | {_ah_h_label}（主） | {_ah_a_label}（客） | 和局推注 | λ主/客 |\n"
                f"|------|-----------|-----------|----------|--------|\n"
                f"| **亚盘({ah_line:+g})** | {_ah_cover_pct}% | {_ah_away_pct}% |"
                f" {_ah_push_pct}% | {_ah_lam_h}/{_ah_lam_a} |"
            )

        state["prebuilt_quant_section"] = _quant_table

        # ── Step 2d: 价值差预计算（含 AH）──
        state["value_edge"] = _compute_value_edge(
            wdl_dict, ou_dict, odds_data, ah_pred=ah_pred, ah_line=ah_line
        )

        # ── Step 2e: 持久化 value_edge 到 prediction_audit（Phase 3）──
        try:
            _persist_value_edge(conn, mid, state["value_edge"])
        except Exception as _pe:
            log.debug(f"  _persist_value_edge 非致命失败: {_pe}")

        # ── Phase-1 完成：打包 job 供 Phase-2 使用 ──
        _ah_raw_audit = odds_data.get("asian_handicap", {}).get("latest", {})
        _ah_h_odds    = float(_ah_raw_audit.get("over_or_home") or 0)
        _ah_a_odds    = float(_ah_raw_audit.get("under_or_away") or 0)
        _ah_pick_for_audit = ('home' if _ah_h_odds > _ah_a_odds
                              else ('away' if _ah_a_odds > _ah_h_odds else None))
        _ah_line_for_audit = ah_line if ah_line != 0 else None

        m_date = m.get('date')
        if not m_date:
            log.warning(f"  [skip] match {m.get('id')} 缺失 kickoff date，跳过以避免占位行")
            continue

        prepared_jobs.append({
            'm':                  m,
            'mid':                mid,
            'home_team':          home_team,
            'away_team':          away_team,
            'state':              state,
            'ml_output':          ml_output,
            'odds_data':          odds_data,
            'h_feat':             h_feat,
            'a_feat':             a_feat,
            'lineup_data':        lineup_data,
            # 用比赛的 UTC 开球日期（m['date'] = kickoff_str[:10]，UTC 标准）
            # 而非 report 生成日的 UTC 日期，避免 19:00 UTC 欧洲场次跨 CST 日导致
            # prediction_audit.match_date 与 dim_match.Date 差一天。
            'report_date':        m_date,
            '_quant_table':       _quant_table,
            '_market_line':       _market_line,
            'ah_line':            ah_line,
            '_ah_line_for_audit': _ah_line_for_audit,
            '_ah_pick_for_audit': _ah_pick_for_audit,
            '_wdl_pick_cn':       _wdl_pick_cn,
            '_ou_pick_cn':        _ou_pick_cn,
            # CLAUDE.md §16: picks 透传到 Phase 2，让 log_prediction 在同事务内
            # 把 picked_market/direction/odds/confidence 一并写入 prediction_audit
            'picks':              _picks,
            'stagger_idx':        len(prepared_jobs),  # 错峰延迟序号
        })
        log.info(f"  ✅ [Phase-1] 预测完成: {m['match_name']}")

    conn.close()

    # ── Phase 2: 双线程 LLM 研报生成（错峰启动，每场间隔 25s）──────────────
    log.info(f"\n{'='*55}")
    worker_fn = _process_match_with_503_retry if args.final else _process_match_llm_phase
    mode_tag = "[--final]" if args.final else ""
    log.info(f"🔀 Phase-2 启动 {mode_tag} ({len(prepared_jobs)} 场，错峰 25s/场，max_workers=2)...")
    with ThreadPoolExecutor(max_workers=2) as executor:
        fs = {executor.submit(worker_fn, job): job['m']['match_name']
              for job in prepared_jobs}
        for fut in as_completed(fs):
            mname = fs[fut]
            try:
                result = fut.result()
                if result:
                    all_summaries.append(result)
                    log.info(f"  ✅ 研报完成: {mname}")
            except Exception as e:
                log.error(f"  ❌ 研报失败 [{mname}]: {e}")

    log.info(f"\n{'='*55}")
    log.info(f"🏁 全部完成，共 {len(all_summaries)} 场")
    for s in all_summaries:
        log.info(f"  - {s['match']}: {os.path.basename(s['path'])}")

    # ── Reconciliation：保证每场都有 picked_market（CLAUDE.md §16 不变量）──
    try:
        batch_mids = [str(s.get("match_id")) for s in all_summaries if s.get("match_id")]
        n_fixed = _reconcile_picks_for_today(batch_mids if batch_mids else None)
        if n_fixed > 0:
            log.error(
                f"[reconcile] ⚠️ 本批次补写 {n_fixed} 场缺失 picks —— "
                f"说明 Phase 1 record_picked 与 Phase 2 log_prediction 都失败，"
                f"请检查 ingest_failure_log（step IN ('record_picked','log_prediction')）"
            )
        else:
            log.info("[reconcile] ✅ 本批次 picks 完整，无需补写")
    except Exception as _re:
        log.error(f"[reconcile] 自身失败（不阻塞主流程）: {_re}", exc_info=True)

    # ── Server酱推送 ─────────────────────────────────────────────────────────
    try:
        from notify_utils import notify
        if all_summaries:
            lines = []
            for s in all_summaries:
                ml = s.get("ml", {})
                sp = ml.get("single_pick", {})
                if sp:
                    pick_str = f"{sp.get('label','')} @{sp.get('odds','?')} [{sp.get('confidence','')}]"
                else:
                    wdl = ml.get("wdl", {})
                    pick_str = f"主{wdl.get('home',0):.0%}/平{wdl.get('draw',0):.0%}/客{wdl.get('away',0):.0%}"
                lines.append(f"⚽ {s['match']}  →  {pick_str}")
            body = "\n".join(lines)
            _ok = notify(
                title=f"喵弟研报 · {len(all_summaries)} 场已就绪",
                msg=body
            )
            if _ok:
                log.info(f"📱 Server酱通知已发送（{len(all_summaries)} 场）")
                # 记录本批次推送时间到所有成功研报的 report_store
                try:
                    _c = sqlite3.connect(DB_PATH)
                    _now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                    _ids = [s.get('match_id') for s in all_summaries if s.get('match_id')]
                    if _ids:
                        _c.executemany(
                            "UPDATE report_store SET push_sent_at=? WHERE match_id=?",
                            [(_now, mid_) for mid_ in _ids]
                        )
                        _c.commit()
                    _c.close()
                except Exception as _e:
                    log.warning(f"写 push_sent_at 失败: {_e}")
            else:
                log.error(f"❌ Server酱通知失败（真实返回非 code=0，见上方日志）")
        else:
            log.info("📭 无成功研报，跳过 Server酱通知")
    except Exception as _e:
        log.warning(f"Server酱通知异常: {_e}")


def _fallback_report(m, ml, odds_data, h_feat, a_feat, lineup_data=None) -> str:
    """LLM 失败时的增强型降级报告"""
    eu = odds_data.get("european_1x2", {}).get("latest", {})
    eu_h = float(eu.get("home", 0) or 0)
    eu_d = float(eu.get("draw", 0) or 0)
    eu_a = float(eu.get("away", 0) or 0)
    ah = odds_data.get("asian_handicap", {}).get("latest", {})
    ah_line  = ah.get("line", "—")
    ah_home  = ah.get("over_or_home", "—")
    ah_away  = ah.get("under_or_away", "—")
    wdl = ml["wdl"]
    ou  = ml["ou"]
    ou_raw  = odds_data.get("over_under", {}).get("latest", {})
    ou_line = float(ou_raw.get("line", 2.5) or 2.5)
    # 用市场实际线概率（已存入 ou_dict；若无则实时转换）
    ou_over_mkt  = ou.get("over_market") or _poisson_convert_ou(ou.get("over_25", 0), ou_line)
    ou_under_mkt = ou.get("under_market") or round(1.0 - ou_over_mkt, 4)
    conf = ml["confidence"]
    
    lineup_str = "阵容数据暂不可用"
    if lineup_data:
        h_lineup = lineup_data.get("home", {})
        a_lineup = lineup_data.get("away", {})
        status = lineup_data.get("status", "predicted")
        lineup_str = f"**状态**: {status}\n\n"
        lineup_str += f"**主队 ({h_lineup.get('formation', 'N/A')})**: {len(h_lineup.get('starters', []))}人首发, {len(h_lineup.get('missing', []))}人缺阵\n"
        lineup_str += f"**客队 ({a_lineup.get('formation', 'N/A')})**: {len(a_lineup.get('starters', []))}人首发, {len(a_lineup.get('missing', []))}人缺阵\n"
        
        if h_lineup.get("key_absences"):
            lineup_str += "\n**主队关键缺阵**: " + ", ".join([p['name'] for p in h_lineup['key_absences']])
        if a_lineup.get("key_absences"):
            lineup_str += "\n**客队关键缺阵**: " + ", ".join([p['name'] for p in a_lineup['key_absences']])

    sp = ml.get("single_pick", {})
    if sp:
        odds_str = f" @{sp['odds']}" if sp.get("odds") else ""
        # B6：前端不显示置信等级
        pick_section = (
            f"**推荐方向**：{sp['label']}（{sp['market']}）{odds_str}\n"
            f"**ML 概率**：{sp['ml_prob']:.1%}\n"
            f"**核心依据**：{sp.get('rationale', '')}"
        )
        if sp.get("secondary"):
            s2 = sp["secondary"]
            o2 = f" @{s2['odds']}" if s2.get("odds") else ""
            pick_section += (
                f"\n\n**附加推荐**：{s2['label']}（{s2['market']}）{o2}  "
                f"ML {s2['ml_prob']:.1%}"
            )
    else:
        pick_section = "**推荐数据暂缺，请参考概率表。**"

    return f"""# {m['match_name']} · 全自动量化研报
