def _predict_bp(home_name: str, away_name: str,
                ou_line: float = 2.5, ah_line: float = 0.0) -> dict | None:
    """调 BP 模型输出 WDL/OU/AH 联合概率；若未加载或队名缺失则返回 None。"""
    bp = _get_bp_model()
    if bp is None:
        return None
    l1, l2, l3 = bp.get_lambdas(home_name, away_name)
    if l1 is None:
        return None
    from models_v5.bivariate_poisson import BivariatePoissonModel
    M = BivariatePoissonModel.score_matrix(l1, l2, l3, max_goals=bp.max_goals)
    mkts = BivariatePoissonModel.markets_from_matrix(M, ah_line=ah_line, ou_line=ou_line)
    mkts["lambda_home"] = l1
    mkts["lambda_away"] = l2
    mkts["lambda3"]     = l3
    return mkts


def _calc_shap_top3_wdl(explainer, X, wdl_probs, feature_names):
    """WDL 最大概率方向 Top-3 SHAP"""
    try:
        sv = explainer.shap_values(X)
        best_class = int(wdl_probs.argmax())
        vals = sv[best_class][0] if isinstance(sv, list) else sv[0, :, best_class]
        top_idx = sorted(range(len(vals)), key=lambda i: abs(vals[i]), reverse=True)[:3]
        label = {0: '主胜', 1: '平局', 2: '客胜'}.get(best_class, str(best_class))
        return [{"feature": feature_names[i], "shap_value": round(float(vals[i]), 4), "direction": label}
                for i in top_idx]
    except Exception as e:
        log.warning(f"SHAP WDL 失败: {e}")
        return []


def _calc_shap_top3_ou(explainer, X, ou_prob, feature_names):
    """OU 方向 Top-3 SHAP"""
    try:
        sv = explainer.shap_values(X)
        if isinstance(sv, list):
            vals = sv[1][0] if ou_prob >= 0.5 else sv[0][0]
        else:
            vals = sv[0]
        top_idx = sorted(range(len(vals)), key=lambda i: abs(vals[i]), reverse=True)[:3]
        direction = '大球' if ou_prob >= 0.5 else '小球'
        return [{"feature": feature_names[i], "shap_value": round(float(vals[i]), 4), "direction": direction}
                for i in top_idx]
    except Exception as e:
        log.warning(f"SHAP OU 失败: {e}")
        return []


def _poisson_convert_ou(p_over_25: float, market_line: float) -> float:
    """
    用 Poisson 分布把 ML 的 P(进球>2.5) 转换为 P(进球>market_line)。

    亚盘线类型：
      X.5  → P_eff = P(>=X+1)                           半球线，直接取整
      X.25 → P_eff = P(>=X+1) + 0.5*P(=X)              四分之一球，=X 时半负（退半注）
      X.75 → P_eff = P(>=X+2) + 0.5*P(=X+1)            四分之三球，=X+1 时半赢
      X.0  → P_eff = P(>=X+1)                           整球线，=X 时平（退全注）
    """
    import math

    if market_line <= 2.5:
        return p_over_25  # 训练线即是实际线，无需转换

    # 把概率钳位到合法范围
    p = max(0.001, min(0.999, p_over_25))

    # 二分法求泊松 λ，使 P(goals>=3) = p
    # P(goals<=2) = e^-λ * (1 + λ + λ²/2)
    target = 1.0 - p

    def cdf2(lam):
        return math.exp(-lam) * (1.0 + lam + lam * lam / 2.0)

    lo, hi = 0.01, 20.0
    for _ in range(60):
        mid = (lo + hi) / 2.0
        if cdf2(mid) > target:
            lo = mid
        else:
            hi = mid
    lam = (lo + hi) / 2.0

    def pmf(k):
        if k < 0 or k > 40:
            return 0.0
        return math.exp(-lam) * (lam ** k) / math.factorial(k)

    base = int(market_line)
    frac = market_line - base

    # P(goals <= base)
    p_le_base = sum(pmf(k) for k in range(base + 1))
    p_gt_base = max(0.0, 1.0 - p_le_base)   # P(goals >= base+1)

    if abs(frac - 0.5) < 0.01:              # X.5 线
        return min(p_gt_base, 0.995)

    elif abs(frac - 0.25) < 0.01:           # X.25 线：=base 时退半注
        p_eq_base = pmf(base)
        return min(p_gt_base + 0.5 * p_eq_base, 0.995)

    elif abs(frac - 0.75) < 0.01:           # X.75 线：=base+1 时赢半注
        p_eq_base1 = pmf(base + 1)
        p_le_base1 = p_le_base + p_eq_base1
        p_gt_base1 = max(0.0, 1.0 - p_le_base1)  # P(goals >= base+2)
        return min(p_gt_base1 + 0.5 * p_eq_base1, 0.995)

    else:                                    # X.0 整球线：=base 时退全注
        return min(p_gt_base, 0.995)


def _compute_value_edge(wdl: dict, ou: dict, odds_data: dict,
                        ah_pred=None, ah_line=None) -> dict:
    """预计算 ML 概率 vs 市场隐含概率的价值差表（含 AH 亚盘维度）"""
    eu = odds_data.get("european_1x2", {}).get("latest", {})
    eu_h = float(eu.get("home", 0) or 0)
    eu_d = float(eu.get("draw", 0) or 0)
    eu_a = float(eu.get("away", 0) or 0)

    # 欧赔归一化隐含概率
    if eu_h > 1 and eu_d > 1 and eu_a > 1:
        s = (1/eu_h) + (1/eu_d) + (1/eu_a)
        imp_h, imp_d, imp_a = (1/eu_h)/s, (1/eu_d)/s, (1/eu_a)/s
    else:
        imp_h = imp_d = imp_a = None

    # OU 隐含概率（使用实际市场线）
    ou_raw = odds_data.get("over_under", {}).get("latest", {})
    market_line = float(ou_raw.get("line", 2.5) or 2.5)
    ou_over_w  = float(ou_raw.get("over_or_home", 0) or 0)
    ou_under_w = float(ou_raw.get("under_or_away", 0) or 0)
    if ou_over_w > 0 and ou_under_w > 0:
        ou_over_odds  = 1 + ou_over_w
        ou_under_odds = 1 + ou_under_w
        s2 = (1/ou_over_odds) + (1/ou_under_odds)
        imp_o, imp_u = (1/ou_over_odds)/s2, (1/ou_under_odds)/s2
    else:
        imp_o = imp_u = None

    # 将 ML P(>2.5) 转换为 P(>market_line)
    ml_over_market  = _poisson_convert_ou(ou.get("over_25", 0), market_line)
    ml_under_market = round(1.0 - ml_over_market, 4)

    # 大小球方向标签含实际盘口线
    over_label  = f"大球(>{market_line})"
    under_label = f"小球(≤{market_line})"

    def _edge_label(edge):
        if edge is None: return "数据缺失"
        if edge > 0.05: return "显著正向价值"
        if edge > 0.02: return "轻微正向价值"
        if edge > -0.02: return "合理定价"
        return "市场溢价"

    directions = [
        ("主胜",       "WDL", wdl.get("home", 0), imp_h, eu_h if eu_h > 1 else None),
        ("平局",       "WDL", wdl.get("draw", 0), imp_d, eu_d if eu_d > 1 else None),
        ("客胜",       "WDL", wdl.get("away", 0), imp_a, eu_a if eu_a > 1 else None),
        (over_label,  "OU",  ml_over_market,      imp_o, round(1+ou_over_w, 2) if ou_over_w > 0 else None),
        (under_label, "OU",  ml_under_market,     imp_u, round(1+ou_under_w, 2) if ou_under_w > 0 else None),
    ]

    # AH 亚盘（Dixon-Coles + xG 模型）
    if ah_pred and ah_line is not None:
        ah_raw  = odds_data.get("asian_handicap", {}).get("latest", {})
        _ah_h_w = float(ah_raw.get("over_or_home", 0) or 0)
        _ah_a_w = float(ah_raw.get("under_or_away", 0) or 0)
        # NowGoal 亚盘赔率以"水位"格式存储（同 OU），需 +1 转换为小数赔率
        ah_h_od = round(1 + _ah_h_w, 3) if _ah_h_w > 0 else 0.0
        ah_a_od = round(1 + _ah_a_w, 3) if _ah_a_w > 0 else 0.0
        # 亚盘市场隐含概率（归一化）
        if ah_h_od > 1 and ah_a_od > 1:
            s3 = (1/ah_h_od) + (1/ah_a_od)
            imp_ah_h = (1/ah_h_od) / s3
            imp_ah_a = (1/ah_a_od) / s3
        else:
            imp_ah_h = imp_ah_a = None

        # NowGoal 约定：正值 = 主队让分（主让），负值 = 主队受让（主受）
        if ah_line > 0:
            ah_h_label = f"主让{abs(ah_line):.2g}"
            ah_a_label = f"客受{abs(ah_line):.2g}"
        else:
            ah_h_label = f"主受{abs(ah_line):.2g}"
            ah_a_label = f"客让{abs(ah_line):.2g}"

        directions.append((
            ah_h_label, "AH",
            ah_pred["ah_cover"], imp_ah_h,
            round(ah_h_od, 2) if ah_h_od > 1 else None
        ))
        directions.append((
            ah_a_label, "AH",
            ah_pred["ah_away_cover"], imp_ah_a,
            round(ah_a_od, 2) if ah_a_od > 1 else None
        ))

    table = []
    for label, market, ml_p, mkt_p, ref_odds in directions:
        edge = round(ml_p - mkt_p, 4) if mkt_p is not None else None
        table.append({
            "direction": label, "market": market,
            "ml_prob": round(ml_p, 4),
            "market_implied_prob": round(mkt_p, 4) if mkt_p else None,
            "edge": edge,
            "edge_pct": f"{edge:+.1%}" if edge is not None else "N/A",
            "edge_label": _edge_label(edge),
            "reference_odds": ref_odds,
        })

    positive = [d for d in table if d["edge"] is not None and d["edge"] > 0]
    best_value = max(positive, key=lambda x: x["edge"]) if positive else None
    return {"directions": table, "best_value": best_value}


def _persist_value_edge(conn: sqlite3.Connection, match_id, edge: dict) -> None:
    """
    Phase 3 Step 9: 将 value_edge 计算结果持久化到 prediction_audit。
    写入 market_home/draw/away, edge_home/draw/away, edge_label, kelly_fraction。
    若表缺少这些列（迁移007未跑）则静默忽略。
    """
    if not edge:
        return
    directions = edge.get("directions", [])

    # 提取 WDL 方向的市场隐含概率和 edge
    def _find(label_key: str, market: str = "WDL"):
        for d in directions:
            if d.get("market") == market and label_key in d.get("direction", ""):
                return d
        return None

    home_d = _find("主胜")
    draw_d = _find("平局")
    away_d = _find("客胜")

    market_home  = home_d["market_implied_prob"] if home_d else None
    market_draw  = draw_d["market_implied_prob"] if draw_d else None
    market_away  = away_d["market_implied_prob"] if away_d else None
    edge_home    = home_d["edge"] if home_d else None
    edge_draw    = draw_d["edge"] if draw_d else None
    edge_away    = away_d["edge"] if away_d else None

    # 最大 edge 方向 → edge_label
    best = edge.get("best_value")
    if best:
        dir_label = best["direction"]
        if "主胜" in dir_label:
            el = "value_home"
        elif "平局" in dir_label:
            el = "value_draw"
        elif "客胜" in dir_label:
            el = "value_away"
        else:
            el = "no_edge"
    else:
        el = "no_edge"

    # Quarter Kelly: f = max(0, min(0.25, (p*b - (1-p)) / b))
    kelly = None
    if best and best.get("ml_prob") and best.get("reference_odds"):
        try:
            p = float(best["ml_prob"])
            b = float(best["reference_odds"]) - 1.0
            if b > 0:
                kelly = round(max(0.0, min(0.25, (p * b - (1 - p)) / b)), 4)
        except (TypeError, ValueError):
            pass

    try:
        conn.execute("""
            UPDATE prediction_audit
            SET market_home=?, market_draw=?, market_away=?,
                edge_home=?, edge_draw=?, edge_away=?,
                edge_label=?, kelly_fraction=?
            WHERE match_id=?
        """, (market_home, market_draw, market_away,
              edge_home, edge_draw, edge_away,
              el, kelly,
              str(match_id)))
        conn.commit()
    except Exception as e:
        # 列不存在（迁移007未执行）时静默忽略
        log.debug(f"  _persist_value_edge 失败（迁移007未跑?）: {e}")


def _get_reference_odds(pick: str, odds_data: dict) -> Optional[float]:
    """从赔率数据中取出对应方向的参考赔率（展示用，不参与选择逻辑）"""
    try:
        eu = odds_data.get("european_1x2", {}).get("latest", {})
        ou_raw = odds_data.get("over_under", {}).get("latest", {})
        if pick == "home_win":
            v = float(eu.get("home", 0) or 0)
            return v if v > 1 else None
        elif pick == "draw":
            v = float(eu.get("draw", 0) or 0)
            return v if v > 1 else None
        elif pick == "away_win":
            v = float(eu.get("away", 0) or 0)
            return v if v > 1 else None
        elif pick == "over":
            w = float(ou_raw.get("over_or_home", 0) or 0)
            return round(1 + w, 2) if w > 0 else None
        elif pick == "under":
            w = float(ou_raw.get("under_or_away", 0) or 0)
            return round(1 + w, 2) if w > 0 else None
    except Exception:
        pass
    return None


def _select_single_pick(wdl: dict, ou: dict, odds_data: dict, ah_pred=None,
                        league_id: int = None, bp_pred: dict = None) -> dict:
    """
    选出模型把握最大的唯一推荐方向。

    规则：
    - 置信等级 LOW → 返回「观望」（A4：LOW 命中率低于硬币，不输出推荐）。
    - OU 方向使用 Poisson 转换后的市场实际盘口概率（而非训练用的 >2.5）；
      并叠加联赛级 OU 偏置校正（A1/A2）。
    - WDL 概率经温度缩放 + 方向微调（A3）。
    - 用归一化置信分跨市场公平比较，消除 WDL 因三方向占优的偏差：
        score = (ml_prob - 等概率基准) / (1 - 等概率基准)
        WDL 基准 = 1/3（三选一），OU/AH 基准 = 1/2（二选一）
    - 置信等级：HIGH(score≥0.45) / MID(score≥0.30) / LOW(其余→SKIP)
    - AH 方向（Dixon-Coles + xG 模型）与 WDL/OU 公平竞争
    - BP 融合（C3.1）：若 bp_pred 可用，OU/AH 概率以 50:50 加权与原 XGB/DC 平均，
      修正 XGB 系统性低估大球的偏差（近90天各联赛 +3~17pp 偏差）。
    """
    WDL_BASE = 1 / 3
    OU_BASE  = 1 / 2
    AH_BASE  = 1 / 2
    WDL_MIN_ODDS = 1.60   # B5：WDL 赔率 <1.60 不出 WDL 推荐（让位给 OU/AH）

    # ── A3: WDL 温度缩放 + 方向偏置校正 ─────────────────────────────────
    try:
        from calibration.temperature_scale import apply_wdl_calibration
        wdl = apply_wdl_calibration(wdl, _get_wdl_calibration())
    except Exception as _ce:
        pass  # 失败静默降级，用原始概率

    # ── A1/A2: 联赛级 OU 偏置校正 ───────────────────────────────────────
    ou_calib   = _get_ou_calibration()
    lid_info   = ou_calib.get(league_id, {}) if league_id else {}
    ou_bias    = lid_info.get("bias", _GLOBAL_OU_BIAS)   # 正值 = 实际大球率更高

    # 获取实际市场盘口线并转换 ML 概率
    ou_raw = odds_data.get("over_under", {}).get("latest", {})
    market_line = float(ou_raw.get("line", 2.5) or 2.5)
    ou_over_market_raw  = _poisson_convert_ou(ou.get("over_25", 0), market_line)
    # 叠加联赛偏置：实际大球率比模型高 → 提升 over 概率
    ou_over_xgb  = round(min(0.97, max(0.03, ou_over_market_raw + ou_bias)), 4)

    # BP OU 融合：回测显示 50:50 融合使 Brier 变差（0.239→0.245），BP 作为信号保留
    # 但不参与概率融合；AH 同理。仅在 _select_single_pick 里用 BP 做不一致告警。
    ou_over_market = ou_over_xgb  # 原始值：用于写库/对比，不做 post-hoc shift

    # (A) Post-hoc OU bias shift：仅用于 pick 判定（止血 under 偏置），不覆盖原始概率
    p_ou_over_adj = max(0.01, min(0.99, float(ou_over_market) + OU_BIAS_SHIFT))
    p_ou_under_adj = round(1.0 - p_ou_over_adj, 4)

    ou_under_market = round(1.0 - ou_over_market, 4)  # 原始值：用于写库/对比

    over_label  = f"大球(>{market_line})"
    under_label = f"小球(≤{market_line})"

    # OU 基线：用历史实际 over 率（而非 0.5）作为等概率点，消除 under 选择偏差。
    # calibration_league.ou_actual_rate 约为 0.48~0.62 视联赛不同，fallback 0.55。
    ou_actual_base = float(lid_info.get("actual_rate") or 0.55)
    # 对称 score 公式：over 用 base=actual_rate，under 用 base=1-actual_rate
    # 这样 over 超出基线才加分，under 低于基线才加分
    # WDL 不再参与单推竞争（2026-04-28：WDL 近期命中率低，AH/OU 是核心竞争力）
    # WDL 概率仍计算并存储，供前端概率三宫格展示，不影响 pred_wdl_* 字段。
    candidates = []
    for market, pick, label, prob, base in [
        # OU：pick 判定使用 p_ou_over_adj / p_ou_under_adj（原始 ou_over_market 保留用于审计）
        ("OU",  "over",     over_label,  p_ou_over_adj,    ou_actual_base),
        ("OU",  "under",    under_label, p_ou_under_adj,   1 - ou_actual_base),
    ]:
        # 防 base 过大导致分母为负；OU 基线 clip 到 [0.3, 0.7]
        b = max(0.3, min(0.7, base))
        score = (prob - b) / (1 - b) if prob >= b else (prob - b) / b
        ref_odds  = _get_reference_odds(pick, odds_data)
        candidates.append({
            "market": market, "pick": pick, "label": label,
            "ml_prob": prob, "conf_score": score, "odds": ref_odds,
        })

    # ── AH 方向（Dixon-Coles + xG 独立预测，仅在有预测时参与竞争）──────
    if ah_pred:
        ah_raw   = odds_data.get("asian_handicap", {}).get("latest", {})
        ah_line_val = float(ah_raw.get("line", 0) or 0) if ah_raw.get("line") is not None else None
        _h_w = float(ah_raw.get("over_or_home", 0) or 0)
        _a_w = float(ah_raw.get("under_or_away", 0) or 0)
        # NowGoal 亚盘赔率以"水位"格式存储（同 OU），需 +1 转换为小数赔率
        h_odds = round(1 + _h_w, 3) if _h_w > 0 else 0.0
        a_odds = round(1 + _a_w, 3) if _a_w > 0 else 0.0

        if ah_line_val is not None:
            # AH BP 融合：OU 回测显示硬融合伤准确率，AH 暂不硬融合（bp_pred 保留为信号）
            # 主队覆盖
            cover = ah_pred["ah_cover"]
            # NowGoal 约定：正值 = 主队让分（主让），负值 = 主队受让（主受）
            if ah_line_val > 0:
                ah_home_label = f"主让{abs(ah_line_val):.2f}".rstrip("0").rstrip(".")
            else:
                ah_home_label = f"主受{abs(ah_line_val):.2f}".rstrip("0").rstrip(".")
            candidates.append({
                "market":     "AH",
                "pick":       "ah_home_cover",
                "label":      ah_home_label,
                "ml_prob":    round(cover, 4),
                "conf_score": (cover - AH_BASE) / (1 - AH_BASE),
                "odds":       h_odds if h_odds > 1 else None,
            })

            # 客队覆盖
            away_cover = ah_pred["ah_away_cover"]
            if ah_line_val < 0:
                ah_away_label = f"客让{abs(ah_line_val):.2f}".rstrip("0").rstrip(".")
            else:
                ah_away_label = f"客受{abs(ah_line_val):.2f}".rstrip("0").rstrip(".")
            candidates.append({
                "market":     "AH",
                "pick":       "ah_away_cover",
                "label":      ah_away_label,
                "ml_prob":    round(away_cover, 4),
                "conf_score": (away_cover - AH_BASE) / (1 - AH_BASE),
                "odds":       a_odds if a_odds > 1 else None,
            })

    # 按归一化置信分降序
    candidates.sort(key=lambda x: x["conf_score"], reverse=True)
    # 兜底：AH/OU 均无有效候选（极罕见，通常意味着赔率数据完全缺失）
    if not candidates:
        ou_dir = "over" if p_ou_over_adj >= 0.5 else "under"
        return {
            "market": "OU", "pick": ou_dir, "label": over_label if ou_dir == "over" else under_label,
            "ml_prob": round(p_ou_over_adj if ou_dir == "over" else p_ou_under_adj, 4),
            "conf_score": 0.0,
            "odds": _get_reference_odds(ou_dir, odds_data),
            "confidence": "SKIP", "direction": ou_dir,
            "rationale": "AH/OU 赔率数据缺失，兜底输出模型 OU 方向。",
        }
    best  = candidates[0]
    score = best["conf_score"]
    # B6：保留分层但不作为短路条件；SKIP 仅内部标记，前端不暴露
    if score >= 0.45:
        conf = "HIGH"
    elif score >= 0.30:
        conf = "MID"
    elif score >= 0.15:
        conf = "LOW"
    else:
        conf = "SKIP"   # 仅后端分层用，前端仍强制给出推荐

    mkt_map = {"WDL": "胜平负", "OU": "大小球", "AH": "亚盘"}
    market_label = mkt_map.get(best["market"], best["market"])
    ou_bias_note = (
        f"（大小球概率已换算为实际{market_line}球盘口，联赛偏置修正{ou_bias:+.3f}"
        f"，紧急纠偏OU_BIAS_SHIFT={OU_BIAS_SHIFT:+.3f} 仅影响推荐不影响审计）"
        if best["market"] == "OU" else ""
    )
    rationale = (
        f"模型对【{best['label']}】置信度{best['ml_prob']:.1%}"
        f"（{market_label}归一化得分{score:.2f}），"
        f"为本场把握最大方向，置信等级 {conf}。"
        + ou_bias_note
        + (f"（亚盘 Dixon-Coles+xG 独立预测）" if best["market"] == "AH" else "")
    )

    # B2/audit：方向标准化（用于 picked_direction 写入）
    # CLAUDE.md §18：canonical = 长形式（与 actual_wdl 同字典）
    _dir_map = {
        "home_win": "home_win", "draw": "draw", "away_win": "away_win",
        "over": "over", "under": "under",
        "ah_home_cover": "ah_home", "ah_away_cover": "ah_away",
    }

    primary = {
        "market":     best["market"],
        "pick":       best["pick"],
        "label":      best["label"],
        "direction":  _dir_map.get(best["pick"], best["pick"]),
        "ml_prob":    round(best["ml_prob"], 4),
        "conf_score": round(score, 4),
        "odds":       best["odds"],
        "confidence": conf,
        "rationale":  rationale,
    }

    # ── B7：双推（primary=AH/OU HIGH 且另一市场也有强把握时追加）──
    # WDL 已退出单推竞争，双推仅限 AH+OU 组合。
    if primary["market"] in ("AH", "OU") and conf == "HIGH":
        secondary = None
        target_mkt = "OU" if primary["market"] == "AH" else "AH"
        for c in candidates[1:]:
            if c["market"] == target_mkt and c["conf_score"] >= 0.55:
                secondary = c; break
        if secondary:
            primary["secondary"] = {
                "market":    secondary["market"],
                "pick":      secondary["pick"],
                "label":     secondary["label"],
                "direction": _dir_map.get(secondary["pick"], secondary["pick"]),
                "ml_prob":   round(secondary["ml_prob"], 4),
                "conf_score": round(secondary["conf_score"], 4),
                "odds":      secondary["odds"],
                "confidence": "HIGH" if secondary["conf_score"] >= 0.65 else "MID",
            }

    return primary


def invoke_agent_handicap(state: dict, _llm=None) -> str:
    """Agent1 亚盘分析 —— 独立可调用入口（B1 抽出，供 final_lock T-30 重写复用）

    state 需包含：ml_output / odds_data / team_stats_summary / match_info 等字段
    返回：agent1 输出的 markdown 段落文本（不含 ## 标题）
    """
    _flash = _llm or llm_flash
    fn = build_agent_node(_flash, AGENT1_SYSTEM_PROMPT, "agent1_output")
    return fn(state).get("agent1_output", "") or ""


def invoke_agent_ou(state: dict, _llm=None) -> str:
    """Agent2 大小球分析 —— 独立可调用入口（B1 抽出）

    state 需包含：ml_output / odds_data / team_stats_summary / match_info 等字段
    返回：agent2 输出的 markdown 段落文本（不含 ## 标题）
    """
    _flash = _llm or llm_flash
    fn = build_agent_node(_flash, AGENT2_SYSTEM_PROMPT, "agent2_output")
    return fn(state).get("agent2_output", "") or ""


def run_agents(state: dict, _llm_flash=None, _llm_pro=None) -> str:
    """按顺序跑 4 个 Agent（Flash×3 + Pro×1），返回最终研报文本"""
    _flash = _llm_flash or llm_flash
    _pro   = _llm_pro or _flash  # 没有 Pro 则降级到 Flash

    for node_key, prompt, model in [
        ("agent1_output", AGENT1_SYSTEM_PROMPT, _flash),
        ("agent2_output", AGENT2_SYSTEM_PROMPT, _flash),
        ("agent3_output", AGENT3_SYSTEM_PROMPT, _flash),
        ("final_report",  AGENT4_SYSTEM_PROMPT, _pro),
    ]:
        node_fn = build_agent_node(model, prompt, node_key)
        state.update(node_fn(state))
    return state.get("final_report", "")


def _process_match_llm_phase(job: dict) -> dict | None:
    """
    Phase 2（线程池）：LLM 研报生成 + 后处理 + 保存 + DB 同步 + AWS 推送。
    每个线程持有独立的 ReviewEngine 实例，LLM 实例复用模块级变量（无状态 HTTP 客户端）。
    """
    m                  = job['m']
    mid                = job['mid']
    home_team          = job['home_team']
    away_team          = job['away_team']
    state              = job['state']
    ml_output          = job['ml_output']
    odds_data          = job['odds_data']
    h_feat             = job['h_feat']
    a_feat             = job['a_feat']
    lineup_data        = job['lineup_data']
    report_date        = job['report_date']
    _quant_table       = job['_quant_table']
    _market_line       = job['_market_line']
    ah_line            = job['ah_line']
    _ah_line_for_audit = job['_ah_line_for_audit']
    _ah_pick_for_audit = job['_ah_pick_for_audit']
    _wdl_pick_cn       = job['_wdl_pick_cn']
    _ou_pick_cn        = job['_ou_pick_cn']

    # ── 预检：若 report_store 已有合格报告（非降级、长度够），检查是否要跳过重新生成 ──
    # 防止 T-30 刷新时遇到 LLM 503 用降级报告覆盖已有正常报告（Inter vs Como 2026-04-21 事件）。
    _existing_report = None
    _existing_is_good = False
    try:
        _c = sqlite3.connect(DB_PATH)
        _row = _c.execute(
            "SELECT markdown_content FROM report_store WHERE match_id=?", (mid,)
        ).fetchone()
        _c.close()
        if _row and _row[0]:
            _existing_report = _row[0]
            _existing_is_good = (
                len(_existing_report) > 1500
                and "LLM 叙事模块异常回退" not in _existing_report
            )
    except Exception:
        pass

    # ── Step 3: 4-Agent LLM 叙事（Flash×3 + Pro×1）──
    # 错峰延迟：每场比赛按序号错开 25s，避免多场同时打 Gemini API 触发 503
    _stagger = job.get('stagger_idx', 0)
    if _stagger > 0:
        import time as _time
        _delay = _stagger * 25
        log.info(f"  [T] ⏱️ {m['match_name']} 错峰等待 {_delay}s (场次序号={_stagger})...")
        _time.sleep(_delay)
    log.info(f"  [T] 🤖 {m['match_name']} 启动 4-Agent 研报生成 [Flash×3 + Pro×1]...")
    try:
        final_report = run_agents(state, _llm_flash=llm_flash, _llm_pro=llm_pro)
    except Exception as e:
        import traceback
        log.error(f"  [T] ❌ {m['match_name']} Agent 管道失败: {e}\n{traceback.format_exc()}")
        log.info(f"  [T] 🔄 {m['match_name']} 全部降级到 Flash 重试...")
        for k in ("agent1_output", "agent2_output", "agent3_output", "final_report"):
            state[k] = ""
        try:
            final_report = run_agents(state, _llm_flash=llm_fallback, _llm_pro=llm_fallback)
            log.info(f"  [T] ✅ {m['match_name']} Flash 全量兜底成功")
        except Exception as e2:
            log.error(f"  [T] ❌ {m['match_name']} Flash 全量兜底也失败: {e2}")
            final_report = ""  # 留空让后续降级逻辑决定

    # 降级决策：优先保留已有合格报告，否则再走 fallback
    _llm_failed = not final_report or len(final_report.strip()) < 100
    if _llm_failed:
        if _existing_is_good:
            log.warning(
                f"  [T] ♻️ {m['match_name']} LLM 失败，但已有合格旧版研报（{len(_existing_report)}字），"
                "保留旧版不覆盖；Server酱发送降级告警。"
            )
            final_report = _existing_report
            # 发告警推送
            try:
                from notify_utils import notify
                notify(
                    title=f"⚠️ 喵弟研报 LLM 失败降级",
                    msg=f"{m['match_name']}: LLM 全量失败（Pro+Flash 均异常），已保留旧版研报。请稍后手动刷新。"
                )
            except Exception:
                pass
        else:
            log.warning(f"  [T] ⚠️ {m['match_name']} 研报过短或为空，使用降级报告")
            final_report = _fallback_report(m, ml_output, odds_data, h_feat, a_feat, lineup_data)
            # 也通知告警，避免用户收到低质量研报不知情
            try:
                from notify_utils import notify
                notify(
                    title=f"⚠️ 喵弟研报降级通知",
                    msg=f"{m['match_name']}: LLM 叙事失败，已输出纯量化版降级研报。"
                )
            except Exception:
                pass

    # ── Step 3b: 后处理——替换 LLM 量化板块为 Python 精确版本 ──
    import re as _re
    _shap_wdl = ml_output.get('shap_wdl_top3', ml_output.get('attribution', []))
    _shap_ou  = ml_output.get('shap_ou_top3', [])
    _feat_cn  = {
